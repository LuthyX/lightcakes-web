---
// A photo, or a dashed placeholder box until the real photo exists.
// To swap in a real photo, add src (and width/height of the actual file):
//   <Photo alt="Branded cupcakes in a gift box" class="h-48" />
//   <Photo src="/images/cupcakes.jpg" width={1200} height={900} alt="Branded cupcakes in a gift box" class="h-48" />
interface Props {
	src?: string;
	alt: string;
	width?: number;
	height?: number;
	// Placeholder background only
	tone?: "pink" | "sand" | "ground";
	// Arched top (rounded like a window or cake dome) instead of square corners
	arch?: boolean;
	// Sizing, e.g. "h-48"
	class?: string;
}

const { src, alt, width = 1200, height = 900, tone = "pink", arch = false, class: className } = Astro.props;

// rounded-t-full on a box makes the top corners as round as the box allows:
// a semicircle-topped arch on narrow boxes, a soft dome on wide ones
const corners = arch ? "rounded-t-full rounded-b-sm" : "rounded-sm";

const tones = {
	pink: "bg-pink-tint",
	sand: "bg-sand",
	ground: "bg-ground",
};
---

{
	src ? (
		<img
			src={src}
			alt={alt}
			width={width}
			height={height}
			loading="lazy"
			class:list={["w-full object-cover", corners, className]}
		/>
	) : (
		<div
			class:list={[
				"flex w-full items-center justify-center border border-dashed border-ink/25 p-4 text-center text-xs text-ink-soft",
				corners,
				tones[tone],
				className,
			]}
		>
			[Photo — {alt}]
		</div>
	)
}
