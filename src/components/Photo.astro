---
// A photo, or a dashed placeholder box until the real photo exists.
//   <Photo {...photos.birthday.heartRedBows} class="h-64" />   (src + alt from src/photos.ts)
//   <Photo alt="Abimbola in her kitchen" class="h-64" />        (placeholder until it arrives)
//
// Astro's <Image> does the heavy lifting at build time: it reads the original's
// size, writes smaller WebP copies (one per entry in `widths`), and outputs an
// <img> with srcset/sizes so each browser downloads the smallest copy that
// still looks sharp on its screen. width/height and lazy loading come for free.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
	src?: ImageMetadata;
	alt: string;
	// Placeholder background only
	tone?: "pink" | "sand" | "ground";
	// How wide the photo is on screen, so the browser can pick a copy before
	// layout. Default suits a photo filling about half the page on desktop.
	sizes?: string;
	// Load straight away instead of lazily: only for photos at the top of a page
	eager?: boolean;
	// Sizing, e.g. "h-64"
	class?: string;
}

const {
	src,
	alt,
	tone = "pink",
	sizes = "(min-width: 1024px) 50vw, 100vw",
	eager = false,
	class: className,
} = Astro.props;

const tones = {
	pink: "bg-pink-tint",
	sand: "bg-sand",
	ground: "bg-ground",
};
---

{
	src ? (
		<Image
			src={src}
			alt={alt}
			widths={[400, 800, 1200, 1800]}
			sizes={sizes}
			loading={eager ? "eager" : "lazy"}
			class:list={["w-full rounded-sm object-cover", className]}
		/>
	) : (
		<div
			class:list={[
				"flex w-full items-center justify-center rounded-sm border border-dashed border-ink/25 p-4 text-center text-xs text-ink-soft",
				tones[tone],
				className,
			]}
		>
			[Photo — {alt}]
		</div>
	)
}
