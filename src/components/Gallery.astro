---
// Grid of photos: 2 columns on phones, 4 on desktop.
// Used on the homepage, Custom Cakes and the Gallery page.
//   <Gallery photos={[photos.birthday.heartRedBows, photos.childrens.fairyGarden]} />
// Photos come from src/photos.ts; an entry without src shows a placeholder.
import type { ImageMetadata } from "astro";
import Photo from "./Photo.astro";

interface Props {
	photos: { src?: ImageMetadata; alt: string }[];
	// Placeholder backgrounds, alternated. Pick ones that contrast with the section behind.
	tones?: ("pink" | "sand" | "ground")[];
}

const { photos, tones = ["pink", "sand"] } = Astro.props;
---

<!-- Cells are taller than wide because most of the photos are portrait;
     object-cover (in Photo) crops each photo to fill its cell -->
<ul class="grid grid-cols-2 gap-4 lg:grid-cols-4">
	{
		photos.map((photo, i) => (
			// overflow-hidden clips the photo as it zooms; "group" lets the photo react
			// to hovering anywhere on the <li> (group-hover:)
			<li class="group overflow-hidden rounded-sm">
				<Photo
					{...photo}
					tone={tones[i % tones.length]}
					sizes="(min-width: 1024px) 25vw, 50vw"
					class="h-56 transition-transform duration-500 motion-safe:group-hover:scale-105 lg:h-72"
				/>
			</li>
		))
	}
</ul>
