---
// Full-width pink "call to action" band: heading, one line, buttons.
// Used at the bottom of Custom Cakes and the homepage.
//   <CtaBand title="…" text="…">
//     <Button href="/enquire">Start an enquiry</Button>
//   </CtaBand>
interface Props {
	title: string;
	text: string;
}

const { title, text } = Astro.props;
---

<section class="scallop-top bg-pink">
	<div class="mx-auto flex max-w-content flex-col items-center gap-4 px-5 py-14 text-center lg:px-14">
		<h2 class="text-2xl">{title}</h2>
		<p class="max-w-135 text-ink-soft">{text}</p>
		<!-- Buttons stack full-width on phones, sit side by side from sm: up -->
		<div class="mt-2 flex w-full flex-col gap-3.5 sm:w-auto sm:flex-row">
			<slot />
		</div>
	</div>
</section>
