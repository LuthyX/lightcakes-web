---
// Allergen information. The list of 14 is the UK legal list; what her products
// contain is from Abimbola (Nov 2026): milk, eggs and wheat (gluten) in
// everything, no gluten-free options.
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import Prose from "../components/Prose.astro";
import { EMAIL } from "../site";

// The 14 allergens UK food businesses must declare
const allergens = [
	"Celery",
	"Cereals containing gluten (such as wheat, barley, oats)",
	"Crustaceans",
	"Eggs",
	"Fish",
	"Lupin",
	"Milk",
	"Molluscs",
	"Mustard",
	"Peanuts",
	"Sesame",
	"Soya",
	"Sulphur dioxide and sulphites",
	"Tree nuts (such as almonds, hazelnuts, walnuts)",
];
---

<BaseLayout
	title="Allergen information · Light Cakes"
	description="Allergen information for cakes and treats from Light Cakes."
>
	<PageHeader
		title="Allergen information"
		intro="Everything is baked in one small kitchen, so if you have an allergy, please read this and talk to us before you order."
	/>

	<Prose>
		<h2>What's in our cakes</h2>
		<p>
			Every Light Cakes product contains <strong>milk</strong>, <strong>eggs</strong> and <strong>wheat</strong>
			(<strong>gluten</strong>). If your order contains anything else from the list below, we'll tell you in your quote.
		</p>

		<h2>The 14 allergens</h2>
		<p>
			UK law lists 14 allergens that food businesses must tell you about. Every cake and treat is made to order, so
			we'll list the allergens in yours in your quote, before you pay.
		</p>
		<ul>
			{allergens.map((allergen) => <li>{allergen}</li>)}
		</ul>

		<h2>Free-from and dietary requirements</h2>
		<p>
			We don't make gluten-free cakes. And because every recipe contains milk and eggs, we can't offer dairy-free,
			egg-free or vegan cakes either.
		</p>

		<h2>Ask us</h2>
		<p>
			If you're not sure, ask before ordering. You can tell us about allergies on our <a href="/enquire">enquiry form</a>{" "}
			or by emailing {EMAIL}.
		</p>
	</Prose>
</BaseLayout>
