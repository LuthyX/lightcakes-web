---
// FAQs. Answers are from Abimbola (Nov 2026) or already confirmed on the site.
// Anything still unknown is a [bracketed placeholder] for her to answer.
// She doesn't offer tastings: don't add a tastings question.
//
// Answers are HTML strings so they can contain links; set:html outputs them
// as HTML. Safe because this is our own text, never visitor input.
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import CtaBand from "../components/CtaBand.astro";
import PageHeader from "../components/PageHeader.astro";
import { DELIVERY_AREA, whatsappLink } from "../site";

const groups = [
	{
		title: "Ordering",
		questions: [
			{
				q: "How do I order a cake?",
				a: `Send us an <a href="/enquire">enquiry</a> or a message on WhatsApp with your date and a rough idea of what you'd like. We'll come back to you within two working days to talk it through and send you a quote.`,
			},
			{
				q: "How far in advance should I order?",
				a: "Custom cakes need at least 7 days' notice, wedding cakes at least 3 weeks, and corporate orders 10 working days. Cake slices are always available. Working to a shorter deadline? Ask anyway, and we'll tell you honestly if we can.",
			},
			{
				q: "Can you make a cake I've seen online?",
				a: "[Abimbola to confirm: e.g. happy to use a photo as inspiration and create her own version.]",
			},
			{
				q: "How many people will my cake feed?",
				a: "[Abimbola to confirm: a portion guide by size, e.g. a 6-inch cake serves about X.]",
			},
		],
	},
	{
		title: "Payment",
		questions: [
			{
				q: "How do I pay?",
				a: "By card or bank transfer, whichever suits — we'll send you an invoice. For custom and wedding cakes, a 50% deposit secures your date, and the balance is due before delivery.",
			},
			{
				q: "What if I need to cancel my order?",
				a: "If you cancel more than 7 days before your collection or delivery date, your payment is refundable. Cancellations within 7 days of collection or delivery can't be refunded.",
			},
			{
				q: "Do you have budget-friendly options?",
				a: `Yes — our budget-friendly cakes start from £[X]. You can see some of them in the <a href="/gallery#budget-friendly">gallery</a>.`,
			},
		],
	},
	{
		title: "Delivery & collection",
		questions: [
			{
				q: "Do you deliver?",
				a: `Yes — we deliver to ${DELIVERY_AREA}, or you can collect from us in Leeds. [Abimbola to confirm: delivery charges.]`,
			},
			{
				q: "Will you set up the cake at the venue?",
				a: "[Abimbola to confirm: whether set-up is included for wedding and event cakes.]",
			},
		],
	},
	{
		title: "Allergies & dietary requirements",
		questions: [
			{
				q: "Do you make gluten-free, dairy-free or vegan cakes?",
				a: `Not at the moment — every cake and treat we make contains milk, eggs and wheat (gluten). See our <a href="/allergens">allergen information</a> for more.`,
			},
			{
				q: "How do I know what's in my cake?",
				a: `Everything we make contains milk, eggs and wheat (gluten). If your order contains any other allergens, we'll list them in your quote, before you pay. Please tell us about any allergies when you enquire.`,
			},
		],
	},
	{
		title: "Corporate orders",
		questions: [
			{
				q: "Can you add our logo or brand colours?",
				a: "[Abimbola to confirm: how she brands treats, e.g. edible logo toppers on cupcakes, iced logo cookies, branded packaging.]",
			},
			{
				q: "Is there a minimum order?",
				a: "Corporate orders start from £200.",
			},
			{
				q: "Can you invoice our company?",
				a: `Yes — we send formal quotes and invoices with your PO reference. <a href="/corporate-gifting#quote">Request a quote</a>.`,
			},
		],
	},
];
---

<BaseLayout
	title="FAQs · Light Cakes"
	description="Answers to common questions about ordering cakes from Light Cakes in Leeds — lead times, payment, delivery and allergens."
>
	<PageHeader
		eyebrow="FAQs"
		title="Questions we're often asked"
		intro="Can't find what you're looking for? Send us a message — we're always happy to help."
	/>

	<div class="mx-auto flex max-w-180 flex-col gap-10 px-5 pb-15">
		{
			groups.map((group) => (
				<section class="flex flex-col gap-3">
					<h2 class="text-2xl">{group.title}</h2>
					<!-- Each question is a <details>: the browser's built-in expand/collapse,
					     keyboard and screen-reader friendly, no JavaScript -->
					<div class="divide-y divide-border border-y border-border">
						{group.questions.map((item) => (
							<details class="group py-1">
								<summary class="flex min-h-12 cursor-pointer list-none items-center justify-between gap-4 font-semibold [&::-webkit-details-marker]:hidden">
									{item.q}
									<!-- Plus sign that turns into a cross when open -->
									<span
										aria-hidden="true"
										class="text-xl text-rose transition-transform group-open:rotate-45"
									>
										+
									</span>
								</summary>
								<p
									class="pb-4 leading-loose text-ink-soft [&_a]:text-rose [&_a]:underline [&_a]:underline-offset-4"
									set:html={item.a}
								/>
							</details>
						))}
					</div>
				</section>
			))
		}
	</div>

	<CtaBand title="Still have a question?" text="Ask us anything — we'll get back to you within two working days.">
		<Button href="/enquire">Send an enquiry</Button>
		<Button href={whatsappLink("Hi, I have a question about ordering.")} variant="outline">Message on WhatsApp</Button>
	</CtaBand>
</BaseLayout>
