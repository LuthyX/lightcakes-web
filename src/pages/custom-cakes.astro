---
// Frontmatter: runs at build time only. Nothing here reaches the browser.
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import CtaBand from "../components/CtaBand.astro";
import Gallery from "../components/Gallery.astro";
import PageHeader from "../components/PageHeader.astro";
import Photo from "../components/Photo.astro";
import ProcessSteps from "../components/ProcessSteps.astro";
import { whatsappLink } from "../site";
import { photos } from "../photos";

// Category tiles, following the folders Abimbola sorted her photos into.
// Each links to more of that kind in the Gallery. Wedding cakes are a custom-cake
// category, not a separate page (Abimbola, Nov 2026).
const categories = [
	{ title: "Birthday cakes", photo: photos.birthday.heartBlackBows, href: "/gallery#birthday" },
	{ title: "Children's cakes", photo: photos.childrens.jungleFirst, href: "/gallery#childrens" },
	{ title: "Baby shower cakes", photo: photos.babyShower.genderReveal, href: "/gallery#baby-shower" },
	{ title: "Wedding cakes", photo: photos.wedding.dAndTMonogram, href: "/gallery#wedding" },
	{
		title: "Budget-friendly cakes",
		note: "From £[X]",
		photo: photos.budgetFriendly.burgundyPiping,
		href: "/gallery#budget-friendly",
	},
	{ title: "Cupcakes", photo: photos.wedding.brideToBeCupcakes, href: "/gallery#cupcakes" },
];

// "Cakes we've made": different cakes from the tiles above, so nothing repeats
const galleryPhotos = [
	photos.birthday.turquoiseDrip,
	photos.childrens.pinkButterfliesThird,
	photos.babyShower.thirtyAndBlooming,
	photos.birthday.white60th,
	photos.childrens.cloudsTeddyFirst,
	photos.budgetFriendly.sageRuffles,
	photos.babyShower.ohBabyBlue,
	photos.birthday.redCrown,
];

const steps = [
	{
		title: "Tell us about the day",
		text: "The occasion, the date, how many people, and any ideas you already have.",
	},
	{
		title: "We design it with you",
		text: "Flavours, tiers, colours and finish — we'll sketch it out and quote you a price.",
	},
	{
		title: "Secure your date",
		text: "A 50% deposit books your slot. The balance is due before delivery.",
	},
	{
		title: "Baked fresh, delivered",
		text: "Made in the days before your event and delivered set up, ready to go.",
	},
];
---

<BaseLayout
	title="Custom Cakes · LightCakes"
	description="Bespoke celebration cakes for weddings, birthdays, baby showers and every milestone — designed around you and baked by hand."
>
	<PageHeader
		eyebrow="Bespoke celebration cakes"
		title="A cake made for your day, and nobody else's"
		intro="Every cake is designed from scratch around your occasion — your flavours, your colours, your details. Nothing here is off a shelf."
	>
		<!-- AGENTS.md: this page must show a "from" price -->
		<p class="font-display text-xl text-rose italic">Cakes from [YOUR PRICE]</p>
	</PageHeader>

	<!-- CATEGORIES: 2 columns on phones, 3 on desktop. The whole tile is one link
	     (photo + title), so it's a big, easy target; "group" lets hovering anywhere
	     on the tile underline the title. -->
	<section class="mx-auto max-w-content px-5 pb-13 lg:px-14" aria-label="Cake categories">
		<ul class="grid grid-cols-2 gap-x-5 gap-y-8 lg:grid-cols-3">
			{
				categories.map((category) => (
					<li>
						<a href={category.href} class="group flex flex-col gap-3">
							<Photo {...category.photo} sizes="(min-width: 1024px) 33vw, 50vw" class="h-56 lg:h-80" />
							<h2 class="text-xl underline-offset-4 group-hover:underline">{category.title}</h2>
							{category.note && <p class="-mt-2 text-sm text-rose">{category.note}</p>}
						</a>
					</li>
				))
			}
		</ul>
	</section>

	<!-- GALLERY: the most important element on this page -->
	<section class="bg-sand">
		<div class="mx-auto flex max-w-content flex-col gap-6 px-5 py-14 lg:px-14">
			<div class="text-center">
				<h2 class="mb-2 text-2xl">Cakes we've made</h2>
				<p class="text-ink-soft">Most people choose a cake maker by their previous work — so here's ours.</p>
			</div>
			<Gallery photos={galleryPhotos} />
			<a
				href="/gallery"
				class="flex min-h-11 items-center self-center text-sm font-semibold text-ink underline underline-offset-4"
			>
				See the full gallery <span aria-hidden="true">&nbsp;→</span>
			</a>
		</div>
	</section>

	<!-- PROCESS -->
	<section class="mx-auto flex max-w-content flex-col gap-8 px-5 py-15 lg:px-14">
		<h2 class="text-center text-2xl">How a bespoke cake comes together</h2>
		<ProcessSteps steps={steps} />
		<p class="text-center font-display text-lg text-rose italic">
			Custom cakes need at least 7 days' notice — wedding cakes, at least 3 weeks.
		</p>
	</section>

	<CtaBand
		title="Let's talk about your cake"
		text="Send over your date and a rough idea — even a photo you've saved somewhere. We'll take it from there."
	>
		<Button href="/enquire">Start an enquiry</Button>
		<Button href={whatsappLink("Hi, I'd like to ask about a custom cake.")} variant="outline">
			Message on WhatsApp
		</Button>
	</CtaBand>
</BaseLayout>
