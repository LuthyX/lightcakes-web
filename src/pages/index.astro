---
// Frontmatter: runs at build time only. Nothing here reaches the browser.
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import CtaBand from "../components/CtaBand.astro";
import Gallery from "../components/Gallery.astro";
import Photo from "../components/Photo.astro";
import ProcessSteps from "../components/ProcessSteps.astro";
import { INSTAGRAM_URL, whatsappLink } from "../site";

const paths = [
	{
		title: "Corporate Treats",
		text: "Branded cupcakes, logo cookies and gift boxes for client thank-yous, staff appreciation, events and seasonal gifting. Bulk orders welcome.",
		photo: "Corporate gift boxes",
		link: { href: "/corporate-treats#quote", label: "Request a quote" },
	},
	{
		title: "Custom Cakes",
		text: "Bespoke cakes for weddings, birthdays, christenings and every milestone in between — designed around you, from flavour to finish.",
		photo: "Celebration cake",
		link: { href: "/enquire", label: "Start an enquiry" },
	},
];

const steps = [
	{
		title: "Tell us what you need",
		text: "Fill in the quote form or send a message on WhatsApp with your date and rough numbers.",
	},
	{
		title: "We design it together",
		text: "Flavours, sizes, branding and finish — we'll talk it through and send you a quote.",
	},
	{
		title: "Confirm your date",
		text: "A deposit secures your slot in the diary. Pay by card or bank transfer, whichever suits.",
	},
	{
		title: "Baked and delivered",
		text: "Freshly made to order, delivered or ready for collection on the day you need it.",
	},
];

// "Recent work". Replace each alt with a description of the real photo when it's added.
const galleryPhotos = Array.from({ length: 8 }, () => ({ alt: "[Describe the bake]" }));

// Placeholders only: never invent a testimonial (AGENTS.md)
const testimonials = [
	{ quote: "[Client testimonial — to be supplied]", by: "[Name], [Company]" },
	{ quote: "[Client testimonial — to be supplied]", by: "[Name], [Occasion]" },
	{ quote: "[Client testimonial — to be supplied]", by: "[Name], [Company]" },
];
---

<BaseLayout title="LightCakes · Bespoke cakes & branded treats">
	<!-- HERO -->
	<section class="mx-auto flex max-w-content flex-col items-center gap-3.5 px-5 pt-8 pb-7 text-center lg:gap-4.5 lg:px-30 lg:pt-14 lg:pb-9">
		<p class="text-sm font-semibold tracking-widest text-rose uppercase">Baked by hand, in small batches</p>
		<h1 class="max-w-205 text-2xl md:text-3xl lg:text-hero">
			Handmade cakes and treats, made for the people you're celebrating
		</h1>
		<p class="max-w-155 text-ink-soft md:text-lg md:leading-loose">
			Bespoke celebration cakes and beautifully branded corporate treats — from a small kitchen that cares about the
			details.
		</p>
		<!-- Full-width stacked buttons on phones, side by side from sm: up -->
		<div class="mt-1.5 flex w-full flex-col gap-2.5 sm:w-auto sm:flex-row sm:gap-4">
			<Button href="/custom-cakes" class="min-h-12 px-7.5">Custom Cakes</Button>
			<Button href="/corporate-treats" variant="outline" class="min-h-12 px-7.5">Corporate Treats</Button>
		</div>
		<p class="mt-1 font-display text-lg text-rose italic">
			Every order is baked to order — no two cakes are quite the same.
		</p>
	</section>

	<!-- PHOTO STRIP: one photo on phones; three from sm: up, the first wider
	     (a 7-column grid split 3 / 2 / 2) -->
	<div class="mx-auto grid max-w-content gap-4.5 px-5 pb-9 sm:grid-cols-7 lg:px-14 lg:pb-14">
		<Photo alt="Custom wedding cake" arch class="h-55 sm:col-span-3 lg:h-52.5" />
		<!-- Wrappers do the hiding: putting "hidden" on Photo itself would fight
		     with the "flex" it already has (both set display) -->
		<div class="hidden sm:col-span-2 sm:block">
			<Photo alt="Branded corporate cupcakes" tone="sand" arch class="h-55 lg:h-52.5" />
		</div>
		<div class="hidden sm:col-span-2 sm:block">
			<Photo alt="Hands finishing a cake" arch class="h-55 lg:h-52.5" />
		</div>
	</div>

	<!-- TWO PATHS -->
	<section class="scallop-top scallop-bottom bg-pink-tint">
		<div class="mx-auto flex max-w-content flex-col gap-7 px-5 py-8 lg:px-14 lg:py-14">
			<div class="text-center">
				<h2 class="mb-2 text-2xl">Two ways to order</h2>
				<p class="text-ink-soft">
					Whether you're gifting on behalf of a company, or celebrating something personal.
				</p>
			</div>
			<div class="grid gap-5 md:grid-cols-2 md:gap-6">
				{
					paths.map((path) => (
						<div class="flex flex-col gap-3.5 rounded-md bg-ground p-5 lg:p-8">
							<Photo alt={path.photo} tone="sand" class="h-32.5 lg:h-37.5" />
							<h3 class="text-xl">{path.title}</h3>
							<p class="text-sm leading-loose text-ink-soft">{path.text}</p>
							<a
								href={path.link.href}
								class="mt-1 flex min-h-11 items-center self-start text-sm font-semibold text-rose underline underline-offset-4"
							>
								{path.link.label} <span aria-hidden="true">&nbsp;→</span>
							</a>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<!-- HOW ORDERING WORKS -->
	<section class="mx-auto flex max-w-content flex-col gap-8 px-5 py-9 lg:px-14 lg:py-15">
		<h2 class="text-center text-2xl">How ordering works</h2>
		<ProcessSteps steps={steps} />
	</section>

	<!-- RECENT WORK -->
	<section id="gallery" class="mx-auto flex max-w-content flex-col gap-6 px-5 pb-9 lg:px-14 lg:pb-15">
		<div class="flex flex-wrap items-end justify-between gap-2">
			<h2 class="text-2xl">Recent work</h2>
			<a
				href={INSTAGRAM_URL}
				class="flex min-h-11 items-center text-sm font-semibold text-rose underline underline-offset-4"
			>
				See more on Instagram <span aria-hidden="true">&nbsp;→</span>
			</a>
		</div>
		<Gallery photos={galleryPhotos} />
	</section>

	<!-- ABOUT: the authenticity section; it should sound like her, not like marketing -->
	<section id="about" class="scallop-top scallop-bottom bg-sand">
		<div class="mx-auto grid max-w-content items-center gap-8 px-5 py-10 md:grid-cols-2 lg:gap-12 lg:px-14 lg:py-15">
			<!-- Narrower and taller so the arch reads as a tall window, not a flat dome -->
			<Photo alt="The baker at work in her kitchen" tone="ground" arch class="mx-auto h-90 max-w-sm lg:h-110" />
			<div class="flex flex-col gap-4">
				<p class="text-sm font-semibold tracking-widest text-rose uppercase">The person behind it</p>
				<h2 class="text-2xl">Hello, I'm Abimbola</h2>
				<p class="leading-loose text-ink-soft">
					[Her story — how the business started, what she cares about, why she bakes the way she does. Two or three
					short paragraphs in her own voice.]
				</p>
				<!-- Signed off in a handwritten script, with the pink heart from her logo.
				     The heart is decorative, so screen readers skip it. -->
				<p class="flex items-center gap-2 font-script text-3xl text-rose">
					Abimbola
					<svg aria-hidden="true" viewBox="0 0 24 24" class="size-5 fill-pink">
						<path
							d="M12 21s-7.4-4.6-9.5-9.1C.9 8.4 3 5 6.4 5c2 0 3.6 1.1 4.6 2.6C12 6.1 13.6 5 15.6 5c3.4 0 5.5 3.4 3.9 6.9C17.4 16.4 12 21 12 21z"
						></path>
					</svg>
				</p>
			</div>
		</div>
	</section>

	<!-- TESTIMONIALS -->
	<section class="mx-auto flex max-w-content flex-col gap-7 px-5 py-10 lg:px-14 lg:py-15">
		<h2 class="text-center text-2xl">What people say</h2>
		<ul class="grid gap-6 md:grid-cols-3">
			{
				testimonials.map((t) => (
					<li>
						<!-- figure + blockquote + figcaption: the HTML for "a quote and who said it" -->
						<figure class="flex h-full flex-col gap-3.5 rounded-md border border-nude p-7">
							<blockquote class="font-display text-lg leading-normal italic">"{t.quote}"</blockquote>
							<figcaption class="text-xs font-semibold text-rose">{t.by}</figcaption>
						</figure>
					</li>
				))
			}
		</ul>
	</section>

	<CtaBand
		title="Have something to celebrate?"
		text="Tell us the date and roughly what you have in mind — we'll come back to you within one working day."
	>
		<Button href="/enquire">Get a quote</Button>
		<Button href={whatsappLink("Hi, I'd like to ask about an order.")} variant="outline">Message on WhatsApp</Button>
	</CtaBand>
</BaseLayout>
