---
// Frontmatter: runs at build time only. Nothing here reaches the browser.
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import PageHeader from "../components/PageHeader.astro";
import Photo from "../components/Photo.astro";
import QuoteForm from "../components/QuoteForm.astro";
import { DELIVERY_AREA, EMAIL, whatsappLink } from "../site";
import { photos } from "../photos";

// "What we make" grid. Prices are placeholders until the client supplies them.
// The first four are what Abimbola has sent photos of. She doesn't do cookies or
// brownies (Nov 2026); continental breakfast replaces them. TODO: confirm treat
// boxes, and get her description of the continental breakfast.
const products = [
	{
		name: "Cupcakes",
		description:
			"Vanilla, chocolate and red velvet — topped with fresh fruit, or finished with your branding. From [YOUR PRICE] per dozen.",
		photo: photos.cupcakes.strawberryChocolatePair,
	},
	{
		name: "Cake slices",
		description: "Generous slices of vanilla, chocolate and red velvet sponge, boxed for the office. Always available. From [YOUR PRICE].",
		photo: photos.cakeSlices.boxedSlices,
	},
	{
		name: "Event & conference treats",
		description: "Individually wrapped slices with a fork and ribbon, ready to hand out at any headcount. Quoted per event.",
		photo: photos.cakeSlices.wrappedSlicesEvent,
	},
	{
		name: "Christmas slab cakes",
		description: "Boxed and piped in festive colours — a thoughtful gift for clients and teams. Book early, slots fill fast.",
		photo: photos.christmas.slabCakesPair,
	},
	{
		name: "Continental breakfast",
		description: "[Abimbola to describe what's included.] Quoted per order.",
	},
	{
		name: "Corporate treat boxes",
		description: "A mixed selection, branded and ready to gift. From [YOUR PRICE].",
	},
];

// "Why companies order from us"
const reasons = [
	{
		title: "Your branding, done properly",
		text: "We work from your brand guidelines — logo, colours, packaging — so it arrives looking like you sent it.",
	},
	{
		title: "Built for bulk",
		text: "Corporate orders start from £200. Tell us the headcount and we'll tell you what's possible.",
	},
	{
		title: "Invoiced properly",
		text: "Formal quotes and invoices with your PO reference, payable by bank transfer or card.",
	},
	{
		title: "Delivered on the day",
		text: `Delivery to ${DELIVERY_AREA}, or collection. We'll confirm timings when you book.`,
	},
];
---

<BaseLayout
	title="Corporate Gifting · LightCakes"
	description="Cupcakes, cake slices, Christmas slab cakes and event treats for businesses in Leeds — handmade, branded and quoted to your order."
>
	<PageHeader
		eyebrow="For businesses"
		title="Beautifully branded treats, made to represent you"
		intro="Client thank-yous, staff appreciation, conferences, product launches and seasonal gifting — handmade, carefully packaged, and finished with your branding."
	>
		<div class="mt-2">
			<Button href="#quote">Request a quote</Button>
		</div>
		<Photo slot="aside" {...photos.cupcakes.vanillaStack} eager class="h-72 lg:h-96" />
	</PageHeader>

	<!-- WHAT WE MAKE: 1 column on phones, 2 on tablets, 3 on desktop -->
	<section class="mx-auto flex max-w-content flex-col gap-6 px-5 pt-5 pb-14 lg:px-14">
		<h2 class="text-2xl">What we make</h2>
		<ul class="grid gap-x-5.5 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
			{
				products.map((product, i) => (
					<li class="flex flex-col gap-2.5">
						<!-- No photo yet → placeholder named after the product -->
						<Photo
							src={product.photo?.src}
							alt={product.photo?.alt ?? product.name}
							tone={i % 2 === 0 ? "pink" : "sand"}
							sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
							class="h-64"
						/>
						<h3 class="text-xl">{product.name}</h3>
						<p class="text-sm text-ink-soft">{product.description}</p>
					</li>
				))
			}
		</ul>
		<!-- Corporate orders are quoted, not bought on the page, so the exact allergen
		     list goes in the quote rather than on each product -->
		<p class="text-sm text-ink-soft">
			Everything we make contains milk, eggs and wheat (gluten). Anything else in your order will be listed in your
			quote. See our{" "}
			<a href="/allergens" class="text-rose underline underline-offset-4">allergen information</a>.
		</p>
	</section>

	<!-- WHY US -->
	<section class="scallop-top scallop-bottom bg-pink-tint">
		<div class="mx-auto flex max-w-content flex-col gap-7 px-5 py-13 lg:px-14">
			<h2 class="text-2xl">Why companies order from us</h2>
			<ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
				{
					reasons.map((reason) => (
						<li class="flex flex-col gap-2">
							<h3 class="text-xl">{reason.title}</h3>
							<p class="text-sm leading-loose text-ink-soft">{reason.text}</p>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<!-- LEAD TIME -->
	<p class="border-b border-border px-5 py-9 text-center font-display text-lg text-rose italic">
		Please allow at least 10 working days' notice for corporate orders — cake slices are always available.
	</p>

	<!-- QUOTE: the nav's "Get a Quote" button links here via #quote.
	     5-column grid on desktop: intro takes 2 columns, the form 3. -->
	<section id="quote" class="mx-auto grid max-w-content gap-10 px-5 pt-13 pb-15 lg:grid-cols-5 lg:gap-12 lg:px-14">
		<div class="flex flex-col gap-3.5 lg:col-span-2">
			<h2 class="text-2xl">Request a quote</h2>
			<p class="text-sm leading-loose text-ink-soft">
				Tell us roughly what you need and when, and we'll come back to you within two working days with a price.
			</p>
			<p class="text-sm leading-loose text-ink-soft">
				Prefer to talk it through?{" "}
				<a
					href={whatsappLink("Hi, I'd like to ask about a corporate order.")}
					class="text-rose underline underline-offset-4">Message us on WhatsApp</a
				> or email {EMAIL}.
			</p>
			<p class="mt-2 rounded-sm bg-sand p-4.5 text-xs leading-loose text-ink-soft">
				Working to a tight deadline or a specific budget? Say so in the form — we'd rather tell you honestly what's
				possible than quote something that doesn't work.
			</p>
		</div>

		<div class="lg:col-span-3">
			<QuoteForm />
		</div>
	</section>
</BaseLayout>
