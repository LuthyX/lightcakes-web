---
// Frontmatter: runs at build time only. Nothing here reaches the browser.
import "../styles/global.css";
import SocialLinks from "../components/SocialLinks.astro";
import { DELIVERY_AREA, EMAIL, PHONE_DISPLAY, whatsappLink } from "../site";

// Props are this component's "constructor arguments". Pages pass them as
// attributes: <BaseLayout title="...">. The interface is optional, but it
// gives you type-checking / autocomplete in the editor.
interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Light Cakes",
	description = "Bespoke cakes & beautifully branded treats for businesses and celebrations.",
} = Astro.props;

// The client's chosen nav. Enquire isn't a text link: it's the pink button.
const navLinks = [
	{ href: "/", label: "Home" },
	{ href: "/custom-cakes", label: "Custom Cakes" },
	{ href: "/corporate-gifting", label: "Corporate Gifting" },
	{ href: "/about", label: "About" },
	{ href: "/gallery", label: "Gallery" },
	{ href: "/faqs", label: "FAQs" },
];

// Current URL path, e.g. "/custom-cakes" or "/custom-cakes/" — used to mark
// the active nav link. Strip a trailing slash so both forms match.
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en-GB">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<!-- LC monogram on ivory. The .ico is for older browsers that ask for /favicon.ico;
		     apple-touch-icon is what iPhones use for "Add to Home Screen". -->
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="apple-touch-icon" href="/favicon.png" />

		<!-- Google Fonts: the two preconnects open connections early so the fonts arrive sooner -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT,WONK@0,9..144,400..600,0..100,0..1;1,9..144,400..600,0..100,0..1&family=Karla:wght@400;500;600&family=Allura&display=swap"
			rel="stylesheet"
		/>
	</head>
	<!-- Column flexbox + min-h-screen + flex-1 on <main>: main stretches to fill
	     spare height, so the footer sits at the bottom even on short pages -->
	<body class="flex min-h-screen flex-col">
		<!-- Thin contact bar above everything. Phone and social icons only on phones;
		     the email joins them from sm: up, where there's room. -->
		<div class="bg-pink text-xs text-ink">
			<div class="mx-auto flex max-w-content items-center justify-between gap-4 px-5 lg:px-14">
				<div class="flex gap-6">
					<a href={whatsappLink("Hi!")} class="flex min-h-11 items-center hover:underline">{PHONE_DISPLAY}</a>
					<p class="hidden items-center sm:flex">{EMAIL}</p>
				</div>
				<SocialLinks class="-mr-3.5" />
			</div>
		</div>

		<header class="border-b border-border">
			<!-- "group" lets children react to this element's state: group-data-[open]:flex
			     means "display:flex when the <nav> has a data-open attribute".
			     Below xl: logo left, hamburger right. From xl: the flex direction flips to
			     a column, so the logo sits centred above a centred row of links. -->
			<nav
				aria-label="Main"
				class="group mx-auto flex max-w-content flex-wrap items-center justify-between px-5 py-4 lg:px-14 xl:flex-col xl:gap-3 xl:py-6"
			>
				<!-- alt="" because the name is written right next to it: a screen reader would
				     otherwise say "Light Cakes Light Cakes". Not lazy-loaded: it's at the top of
				     every page, so it should load immediately. -->
				<a
					href="/"
					class="flex min-h-11 items-center gap-2.5 font-display text-xl font-semibold xl:flex-col xl:gap-1 xl:text-2xl"
				>
					<img src="/images/logo-mark.png" alt="" width="176" height="192" class="h-10 w-auto xl:h-16" />
					Light Cakes
				</a>

				<!-- Shown below 1280px (xl:hidden): the six links plus logo and button only just
				     fit at laptop width, so the full row waits for xl:. Icon-only, so it needs aria-label.
				     aria-expanded tells screen readers whether the menu is open or closed. -->
				<button
					type="button"
					id="menu-toggle"
					aria-label="Menu"
					aria-expanded="false"
					aria-controls="main-menu"
					class="flex size-11 flex-col items-center justify-center gap-1.25 xl:hidden"
				>
					<span class="block h-0.5 w-5.5 bg-ink"></span>
					<span class="block h-0.5 w-5.5 bg-ink"></span>
					<span class="block h-0.5 w-5.5 bg-ink"></span>
				</button>

				<ul
					id="main-menu"
					class="hidden w-full flex-col gap-1 pt-3 group-data-[open]:flex xl:flex xl:w-auto xl:flex-row xl:items-center xl:gap-9 xl:pt-0"
				>
					{
						navLinks.map((link) => (
							<li>
								<a
									href={link.href}
									aria-current={currentPath === link.href ? "page" : undefined}
									class="flex min-h-11 items-center text-sm font-medium text-ink-soft decoration-pink decoration-2 underline-offset-6 hover:text-ink aria-[current=page]:font-semibold aria-[current=page]:text-ink aria-[current=page]:underline"
								>
									{link.label}
								</a>
							</li>
						))
					}
					<li>
						<a
							href="/enquire"
							class="inline-flex min-h-11 items-center rounded-full bg-pink px-5 text-sm font-semibold text-ink"
						>
							Enquire
						</a>
					</li>
				</ul>
			</nav>
		</header>

		<main class="flex-1">
			<!-- Whatever the page puts between <BaseLayout>...</BaseLayout> is inserted here -->
			<slot />
		</main>

		<!-- Light footer: three columns (about / contact / notice periods), a row of
		     links between two thin rules, then the copyright centred underneath -->
		<footer class="border-t border-nude">
			<div class="mx-auto flex max-w-content flex-col gap-8 px-5 pt-10 pb-6 lg:px-14 lg:pt-14">
				<!-- Stacked on phones, three columns side by side from lg: up -->
				<div class="grid gap-8 lg:grid-cols-3 lg:gap-12">
					<div class="flex flex-col gap-3">
						<p class="font-display text-xl">Light Cakes</p>
						<p class="text-sm leading-loose text-ink-soft">
							Bespoke cakes and beautifully branded treats, baked by hand in Leeds. We deliver to {DELIVERY_AREA}.
						</p>
						<!-- -ml-3.5 lines the first icon up with the text above it (each icon sits
						     centred in a 44px tap box, so it starts ~14px in) -->
						<SocialLinks class="-ml-3.5" />
					</div>

					<div class="flex flex-col gap-3 text-sm">
						<p class="font-display text-xl">Contact</p>
						<p><span class="font-semibold">Based in:</span> Leeds, UK</p>
						<a href={whatsappLink("Hi!")} class="flex min-h-11 items-center self-start">
							<span class="font-semibold">WhatsApp:</span>&nbsp;{PHONE_DISPLAY}
						</a>
						<p><span class="font-semibold">Email:</span> {EMAIL}</p>
					</div>

					<!-- Where the reference site lists opening hours: she works to order, so
					     the useful equivalent is how much notice each kind of order needs -->
					<div class="flex flex-col gap-3 text-sm">
						<p class="font-display text-xl">Notice needed</p>
						<p>Custom cakes: 7 days</p>
						<p>Wedding cakes: 3 weeks</p>
						<p>Corporate orders: 10 working days</p>
					</div>
				</div>

				<nav aria-label="Footer" class="border-y border-nude/50 py-2">
					<ul class="flex flex-wrap justify-center gap-x-10 text-sm text-ink-soft lg:justify-between">
						{
							[
								...navLinks.slice(1),
								{ href: "/enquire", label: "Enquire" },
								{ href: "/privacy", label: "Privacy notice" },
								{ href: "/allergens", label: "Allergen information" },
							].map((link) => (
								<li>
									<a href={link.href} class="flex min-h-11 items-center hover:text-ink">
										{link.label}
									</a>
								</li>
							))
						}
					</ul>
				</nav>

				<p class="text-center text-xs text-ink-soft">&copy; {year} Light Cakes</p>
			</div>
		</footer>

		<script>
			// Astro bundles this and ships it to the browser (unlike the frontmatter).
			const nav = document.querySelector("nav[aria-label='Main']")!;
			const toggle = document.getElementById("menu-toggle")!;

			toggle.addEventListener("click", () => {
				const open = nav.toggleAttribute("data-open");
				toggle.setAttribute("aria-expanded", String(open));
			});

			// Scroll reveal: each top-level block in <main> fades up as it scrolls into
			// view (styles: .reveal in global.css). Skipped for anyone whose system asks
			// for reduced motion, and for blocks already on screen when the page loads,
			// so the top of the page never flickers.
			const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
			if (!reduceMotion && "IntersectionObserver" in window) {
				// IntersectionObserver calls us when a watched element enters the viewport,
				// instead of us checking positions on every scroll event
				const observer = new IntersectionObserver(
					(entries) => {
						for (const entry of entries) {
							if (entry.isIntersecting) {
								entry.target.classList.add("is-visible");
								observer.unobserve(entry.target); // animate once only
							}
						}
					},
					// Fire once the block's top edge is 10% up from the bottom of the screen.
					// (A "10% visible" threshold can take ages on very tall blocks like the gallery.)
					{ threshold: 0, rootMargin: "0px 0px -10% 0px" },
				);

				for (const block of document.querySelectorAll("main > *")) {
					if (block.getBoundingClientRect().top > window.innerHeight) {
						block.classList.add("reveal");
						observer.observe(block);
					}
				}
			}
		</script>
	</body>
</html>
